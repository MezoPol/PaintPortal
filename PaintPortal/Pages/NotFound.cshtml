@page "/NotFound"
@{
    ViewData["Title"] = "Page not found";
}

<div class="text-center py-5">
    <h1 class="display-4">404</h1>
    <p class="lead">Sorry, we could not find that page.</p>
    <a class="btn btn-primary" asp-page="/Index">Back to home</a>
    <a class="btn btn-outline-primary" asp-page="/Catalog/Index">Browse the catalog</a>
</div>